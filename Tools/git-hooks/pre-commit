#!/bin/sh
# Local pre-commit guards (versioned scripts, this hook is a thin runner).
# Install / reinstall after a fresh clone:
#   cp Tools/git-hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: sin python3, salto chequeos"; exit 0; }
root=$(git rev-parse --show-toplevel)

# 1) String Catalog reference cycles — Xcode 26.3 recurses infinitely on a cyclic .xcstrings
#    and OOMs the Mac (FER-395). Logic in Tools/check-xcstrings-cycles.py.
xcstrings=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'Localizable\.xcstrings$')
if [ -n "$xcstrings" ] && [ -f "$root/Tools/check-xcstrings-cycles.py" ]; then
  if ! python3 "$root/Tools/check-xcstrings-cycles.py"; then
    echo ""
    echo "✋ Commit bloqueado: ciclo en un String Catalog (crashea Xcode 26.3 → OOM)."
    echo "   Rómpelo con el patrón FER-395, o commitea con --no-verify si sabes lo que haces."
    exit 1
  fi
fi

# 2) Design-system drift — no raw hex/font/radius/opacity literals in the screens (auditoría jul-2026).
#    Runs only on staged .swift files. Keep the rule scoping in sync with .github/workflows/design-tokens.yml:
#    no-hex on every staged file; the font/radius/opacity rules on staged screens (Cenit/Screens|Onboarding),
#    which are fully migrated. (CenitWidgets/CenitWatch are fixed Dynamic-Island / watch geometry.)
swift_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.swift$')
if [ -n "$swift_staged" ] && [ -f "$root/Tools/check-design-drift.py" ]; then
  fail=0
  python3 "$root/Tools/check-design-drift.py" --rules no-hex $swift_staged || fail=1
  screens_staged=$(printf '%s\n' $swift_staged | grep -E '^Cenit/(Screens|Onboarding)/')
  if [ -n "$screens_staged" ]; then
    # FER-264: alineado con CI (emdash corre allá desde FER-879).
    python3 "$root/Tools/check-design-drift.py" --rules no-emdash-string $screens_staged || fail=1
  fi
  screens_only_staged=$(printf '%s\n' $swift_staged | grep -E '^Cenit/Screens/')
  if [ -n "$screens_only_staged" ]; then
    python3 "$root/Tools/check-design-drift.py" --rules no-raw-shadow $screens_only_staged || fail=1
  fi
  python3 "$root/Tools/check-design-drift.py" --rules no-sheet-glass $swift_staged || fail=1
  # FER-258/263: trinquetes de árbol — el presupuesto es POR ARCHIVO y sólo midiendo el árbol
  # entero se ve una literal / call-site legacy / exención de más.
  if [ -f "$root/Tools/design-drift-baseline.json" ]; then
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-spacing-literal \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-adhoc-font,no-radius-literal,no-opacity-literal \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-raw-color,no-edgeinsets-literal,no-token-arithmetic \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App Cenit/Data Cenit/LiveActivity Cenit/Media CenitApp CenitWidgets CenitWatch) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-motion-literal \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-dt-cap-adhoc Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App Cenit/Data Cenit/LiveActivity Cenit/Media CenitWidgets CenitWatch CenitApp) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-legacy-api \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App Cenit/Data Cenit/LiveActivity Cenit/Media CenitApp CenitWidgets CenitWatch) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-deprecated-metrics,no-instrumento-theme,no-weight-on-grotesk \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App Cenit/Data Cenit/LiveActivity Cenit/Media CenitApp CenitWidgets CenitWatch) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-iphone-tone-on-oled CenitWatch) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-capsule-a-mano,no-confirmation-dialog,no-native-menu Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-native-material Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp Packages/CenitDesign/Sources) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules no-raw-contrast Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App CenitApp Packages/CenitDesign/Sources) || fail=1
    (cd "$root" && python3 Tools/check-design-drift.py --rules token-exempt \
      --baseline Tools/design-drift-baseline.json Cenit/Screens Cenit/Onboarding Cenit/System Cenit/App Cenit/Data Cenit/LiveActivity Cenit/Media Packages/CenitDesign/Sources CenitApp) || fail=1
  fi
  if [ "$fail" -ne 0 ]; then
    echo ""
    echo "✋ Commit bloqueado: deriva del sistema de diseño (usa un token de CenitDesign,"
    echo "   o anota la línea con « // token-exempt(<categoria>): <motivo> » — ver docs/design-system/CONTRATO.md)."
    exit 1
  fi
fi

exit 0
