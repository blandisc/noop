# ── macOS / Finder ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.localized
Icon?
# iCloud Drive / Finder duplicate copies of synced files (e.g. "Units 2.kt").
# A dupe source file silently breaks the build with redeclared symbols.
* [0-9].kt
* [0-9].swift

# ── Swift / Xcode ───────────────────────────────────────────────
# Xcode project is generated from project.yml by XcodeGen — do not commit it.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
build/
DerivedData/
.build/
Packages/*/.build/
Tools/*/.build/
*.swiftpm
.swiftpm/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
# SwiftPM resolved file is fine to commit; uncomment to ignore:
# Package.resolved

# ── App bundles / build output ──────────────────────────────────
*.app/
NOOP.app/

# ── IDE / editor ────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── Misc / secrets (never commit) ───────────────────────────────
*.log
.env
secrets.*

# ── Personal data — NEVER publish (real WHOOP/Apple Health exports) ──
Fixtures/
*.sqlite
*.sqlite-wal
*.sqlite-shm
export.xml
export.zip
*whoop_export*.zip
*apple_health*.zip

# Python bytecode
__pycache__/
*.pyc

# Lazyweb design-tool scratch/cache (screenshots, references)
.lazyweb/

# ── Agent / tooling scratch (local only, never publish) ──
.claude/
.stitch/
.tmp-capture/

# Design exports rescued from worktrees (local reference, not source of truth)
design-export/
