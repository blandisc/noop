#include <metal_stdlib>
using namespace metal;

// MARK: - «El Ecosistema» · Fase B (FER-13)
//
// El shader ES `EcosistemaSimulacion.particula(dir:indice:…)`, evaluada por índice en GPU.
// La función de Swift sigue siendo la SPEC: si cambia allá, cambia aquí, y los tests puros
// de `EcosistemaSimulacionTests` son el contrato compartido.
//
// Nada de constantes mágicas: la física llega en `Fisica` desde los mismos tokens que usa
// el Canvas (`Geometria` / `LiquidEcosistemaMotion`). Lo único intrínseco al shader es la
// espiral de Fibonacci, que se deriva del índice para no subir tablas a la GPU.
//
// ⚠️ Las structs de abajo (y `PolvoU`, FER-118) se reflejan campo a campo en `EcosistemaMetal.swift`.
// Si tocas una, toca la otra: no hay header compartido (un target SwiftPM mixto no lo
// permite limpio) y los tamaños se afirman en `EcosistemaPlanTests.testLayoutDeLosUniformes`.

struct Fisica {
    float aplastamiento;
    float bandaMenisco;
    float pisoNivel;
    float ondaAmplitud;
    // Las FASES llegan ya reducidas a [0, 2π) desde la CPU, en `Double`. NUNCA mandes
    // `t` crudo a la GPU: el reloj de la app es `timeIntervalSinceReferenceDate`
    // (~8.07·10⁸ s) y en `float` el ULP a esa magnitud es de 32–128 rad — la rotación
    // se congelaría por ~53 s y el jitter de 300 partículas colapsaría a 6 fases.
    float faseJitter;    // (t · jitterVelocidad) mod 2π
    float faseOnda;      // (t · nivelOndaVelocidad) mod 2π
    float _p0;
    float _p1;
};

struct NubeU {
    float4 colorTinta;   // clases base / menisco / vapor
    float4 colorAmbar;   // casquete del guardián
    float4 colorBajo;    // líquido fuera de rango
    float2 lienzo;
    float2 centro;
    float  radio;
    float  rot;          // ya reducida a [0, 2π) — ver `Fisica`
    float  jitterAmp;
    float  alfaK;
    float  stretch;
    float  nivel;        // < 0 ⇒ sin modo gauge
    uint   n;            // direcciones de la esfera FUENTE
    uint   paso;         // 1 densa · 2/3 rala (lo «hueco»)
    uint   nivelBajo;
    uint   capAmbar;
    float  nivelMezcla;  // 0 = esfera plena · 1 = gauge pleno (funde el modo nivel)
    float  mezcla;       // morfo (FER-19): la porta el buffer A; vsNube la ignora
};

struct Atomo {
    float4 color;
    float2 centro;
    float2 foco;      // halo: centro del gradiente
    float  radio;
    float  radioIni;  // halo: radio interior (opaco)
    float  grosor;    // > 0 anillo (pt) · 0 disco · < 0 halo
    float  _pad;
};

struct Marco {
    float2 lienzo;
    float2 _pad;
};

// El POLVO de «Hoy en atmósfera» (FER-118): espejo campo a campo de `EcosistemaPolvoU`.
// Los colores ya vienen resueltos (la paleta del héroe) y CADA token de
// `PolvoSimulacion.Fisica` viaja aquí — el shader no tiene números propios.
struct PolvoU {
    float4 colorClima;
    float4 colorNeutra;
    float4 colorReposo;
    float4 colorSueno;
    float4 colorVigiaTemp;
    float4 colorVigiaResp;
    float2 lienzo;
    float  t;               // segundos desde que el fondo apareció (NO el reloj absoluto)
    float  desplazamiento;  // contentOffset.y del scroll, ≥ 0
    float  radioMin;
    float  radioMax;
    float  alfaBase;
    float  alfaRango;
    float  densidadPiso;
    float  densidadDesde;
    float  densidadHasta;
    float  respiracionAmp;
    float  respiracionWMin;
    float  respiracionWRango;
    float  derivaXMax;
    float  derivaYMin;
    float  derivaYRango;
    float  parallax;
    float  alfaNeutra;
    float  umbralClima;
    uint   neutra;          // 1 = sin veredicto: tinta neutra × alfaNeutra
    uint   still;           // 1 = Reduce Motion / render: sin tiempo ni parallax
    float  bordeFade;       // los cuatro bordes se desvanecen en estos pt
    uint   _p1;
};

struct VOut {
    float4 position [[position]];
    float2 uv;        // −1…1 dentro del quad
    float4 color;     // sin premultiplicar
    float2 pt;        // posición en pt del lienzo
    float2 foco;
    float  radio;
    float  radioIni;
    float  grosor;
    float  suavizado; // ancho del antialias del disco en fwidth: 1 = normal · < 1 = más nítido (polvo)
};

// El quad de la instancia, como triangle-strip de 4 vértices.
static inline float2 esquina(uint vid) {
    return float2((vid & 1u) != 0u ? 1.0 : -1.0, (vid & 2u) != 0u ? 1.0 : -1.0);
}

// pt del lienzo (y hacia abajo) → clip space.
static inline float4 aClip(float2 pt, float2 lienzo) {
    return float4(pt.x / lienzo.x * 2.0 - 1.0, 1.0 - pt.y / lienzo.y * 2.0, 0.0, 1.0);
}

// `EcosistemaSimulacion.fibonacci(_:)` para UNA dirección, derivada del índice.
static inline float3 fibonacci(uint i, uint n) {
    float dorado = M_PI_F * (3.0 - sqrt(5.0));
    float y = 1.0 - 2.0 * (float(i) + 0.5) / float(n);
    float r = sqrt(max(0.0, 1.0 - y * y));
    float th = dorado * float(i);
    return float3(cos(th) * r, y, sin(th) * r);
}

// MARK: Nubes de partículas (el puerto de `particula(dir:indice:…)`)

// La física de UNA partícula de nube, compartida por `vsNube` y `vsNubeMorfo` (FER-19):
// una sola copia de la ley — dos copias divergen.
struct NubeEval {
    float2 centro;
    float  tam;
    float  alfa;
    float4 color;
};

static NubeEval evalNube(constant NubeU &u, constant Fisica &f, uint iid) {
    // La partícula `i` toma la dirección `i·paso` de la esfera fuente, y conserva `i`
    // como índice de jitter (idéntico a enumerar la variante rala en el Canvas).
    float3 dir = fibonacci(iid * u.paso, u.n);

    float cr = cos(u.rot), sr = sin(u.rot);
    float x = dir.x * cr + dir.z * sr;
    float z = -dir.x * sr + dir.z * cr;
    float y = dir.y;

    float j = u.jitterAmp == 0.0 ? 0.0
            : sin(f.faseJitter + float(iid) * 2.1) * u.jitterAmp;
    float kx = 1.0 + u.stretch;
    float ky = 1.0 - u.stretch * 0.55;
    float sx = u.centro.x + x * (u.radio + j) * kx;
    float sy = u.centro.y + y * (u.radio + j) * f.aplastamiento * ky;

    float dep = (z + 1.0) * 0.5;
    float tam = 0.7 + dep * 1.5;
    float alfa = (0.15 + dep * 0.5) * u.alfaK;
    float4 color = u.colorTinta;

    if (u.nivel >= 0.0) {
        // Modo gauge fundido por nivelMezcla (espejo de EcosistemaSimulacion.particula):
        // 0 = esfera plena, 1 = gauge pleno — el nivel se revela gradual en el viaje.
        float m = clamp(u.nivelMezcla, 0.0, 1.0);
        float umbral = 1.0 - 2.0 * max(f.pisoNivel, min(1.0, u.nivel));
        if (y > umbral + f.bandaMenisco) {
            if (u.nivelBajo != 0u) { color = u.colorBajo; }
        } else if (y > umbral - f.bandaMenisco) {
            alfa *= 1.0 + 0.5 * m;
            tam *= 1.0 + 0.2 * m;
            if (u.nivelBajo != 0u) { color = u.colorBajo; }
            // La ola del menisco: la superficie del líquido ondula.
            sy += sin(sx * 0.09 + f.faseOnda) * f.ondaAmplitud * m;
        } else {
            // El vapor a 0.12 (opción A «aire del gauge»), fundido por la mezcla.
            alfa *= 1.0 - 0.88 * m;
        }
    }
    if (u.capAmbar != 0u && x > 0.25 && y < -0.15) {
        color = u.colorAmbar;
    }

    NubeEval e;
    e.centro = float2(sx, sy);
    e.tam = tam;
    e.alfa = alfa;
    e.color = color;
    return e;
}

// El quad de una partícula ya evaluada — cola común de los dos vértices de nube.
static VOut quadNube(NubeEval e, uint vid, float2 lienzo) {
    float2 q = esquina(vid);
    VOut out;
    out.position = aClip(e.centro + q * e.tam, lienzo);
    out.uv = q;
    out.color = float4(e.color.rgb, min(1.0, max(0.0, e.alfa)) * e.color.a);
    out.pt = e.centro + q * e.tam;
    out.foco = e.centro;
    out.radio = e.tam;
    out.radioIni = 0.0;
    out.grosor = 0.0;
    out.suavizado = 1.0;
    return out;
}

vertex VOut vsNube(uint vid [[vertex_id]],
                   uint iid [[instance_id]],
                   constant NubeU &u [[buffer(0)]],
                   constant Fisica &f [[buffer(1)]]) {
    return quadNube(evalNube(u, f, iid), vid, u.lienzo);
}

// MORFO (FER-19 · C.2 «Materia continua»): la MISMA dirección `iid` evaluada en la
// config A (buffer 0, que además porta `mezcla`) y en la B (buffer 2), con lerp de
// posición/tamaño/alfa por índice — migración real de materia, nunca crossfade.
// Espejo exacto de `EcosistemaSimulacion.particulaMorfo`.
vertex VOut vsNubeMorfo(uint vid [[vertex_id]],
                        uint iid [[instance_id]],
                        constant NubeU &a [[buffer(0)]],
                        constant Fisica &f [[buffer(1)]],
                        constant NubeU &b [[buffer(2)]]) {
    NubeEval ea = evalNube(a, f, iid);
    NubeEval eb = evalNube(b, f, iid);
    float m = clamp(a.mezcla, 0.0, 1.0);
    NubeEval e;
    e.centro = mix(ea.centro, eb.centro, m);
    e.tam = mix(ea.tam, eb.tam, m);
    e.alfa = mix(ea.alfa, eb.alfa, m);
    e.color = m < 0.5 ? ea.color : eb.color;
    return quadNube(e, vid, a.lienzo);
}

// MARK: El polvo de la atmósfera (FER-118 · el puerto de `PolvoSimulacion.particula`)

// Hash entero de Wang, con la MISMA aritmética uint32 (wrap) que `PolvoSimulacion.wang`.
static inline uint wangPolvo(uint x) {
    x = (x ^ 61u) ^ (x >> 16);
    x = x * 9u;
    x = x ^ (x >> 4);
    x = x * 0x27d4eb2du;
    x = x ^ (x >> 15);
    return x;
}

// `PolvoSimulacion.hash(i, k)` → [0, 1).
static inline float hashPolvo(uint i, uint k) {
    return float(wangPolvo(i * 0x9E3779B1u + k * 0x85EBCA77u)) / 4294967296.0f;
}

// Módulo positivo (`PolvoSimulacion.wrap`): el campo es infinito.
static inline float wrapPolvo(float v, float m) {
    if (m <= 0.0) { return 0.0; }          // misma guarda que Swift: lienzo 0×0 → 0, no NaN
    float r = fmod(v, m);
    return r < 0.0 ? r + m : r;
}

// La partícula `iid` de la atmósfera — espejo exacto de `PolvoSimulacion.particula(...)`.
vertex VOut vsPolvo(uint vid [[vertex_id]],
                    uint iid [[instance_id]],
                    constant PolvoU &u [[buffer(0)]]) {
    float W = u.lienzo.x, H = u.lienzo.y;
    float t = u.still != 0u ? 0.0 : u.t;
    float desp = u.still != 0u ? 0.0 : max(0.0, u.desplazamiento);

    float x0 = hashPolvo(iid, 0u) * W;
    float y0 = hashPolvo(iid, 1u) * H;
    float radio = u.radioMin + hashPolvo(iid, 2u) * (u.radioMax - u.radioMin);
    float vx = (hashPolvo(iid, 6u) - 0.5) * 2.0 * u.derivaXMax;
    float vy = -(u.derivaYMin + hashPolvo(iid, 7u) * u.derivaYRango);
    float x = wrapPolvo(x0 + vx * t, W);
    float y = wrapPolvo(y0 + vy * t - u.parallax * desp, H);

    float rampa = H > 0.0 ? (y / H - u.densidadDesde) / (u.densidadHasta - u.densidadDesde) : 0.0;
    float f = u.densidadPiso + (1.0 - u.densidadPiso) * clamp(rampa, 0.0, 1.0);
    float w = u.respiracionWMin + hashPolvo(iid, 4u) * u.respiracionWRango;
    float fase = 6.28318530718 * hashPolvo(iid, 5u);
    float resp = u.still != 0u ? 1.0 : (1.0 - u.respiracionAmp) + u.respiracionAmp * sin(w * t + fase);
    // Los cuatro bordes se desvanecen (`PolvoSimulacion.Fisica.bordeFade`), como en la spec.
    float borde = smoothstep(0.0, u.bordeFade, x) * smoothstep(0.0, u.bordeFade, W - x)
                * smoothstep(0.0, u.bordeFade, y) * smoothstep(0.0, u.bordeFade, H - y);
    float alfa = (u.alfaBase + u.alfaRango * f) * (0.5 + 0.5 * hashPolvo(iid, 3u)) * resp
               * (u.neutra != 0u ? u.alfaNeutra : 1.0) * borde;

    float4 color = u.colorClima;
    if (u.neutra != 0u) {
        color = u.colorNeutra;
    } else {
        float k = hashPolvo(iid, 8u);
        if (k >= u.umbralClima) {
            float cuarto = (1.0 - u.umbralClima) / 4.0;
            int idx = min(3, int((k - u.umbralClima) / cuarto));
            color = idx == 0 ? u.colorReposo
                  : idx == 1 ? u.colorSueno
                  : idx == 2 ? u.colorVigiaTemp
                  : u.colorVigiaResp;
        }
    }

    NubeEval e;
    e.centro = float2(x, y);
    e.tam = radio;
    e.alfa = alfa;
    e.color = color;
    VOut o = quadNube(e, vid, u.lienzo);
    // FER-125: el polvo con el borde a MEDIO píxel de feather (el héroe conserva el suyo).
    // A radios de 1–2.4 pt un feather de un píxel entero volvía nube cada mota.
    o.suavizado = 0.5;
    return o;
}

// MARK: Átomos sueltos (chispas, motas, espirales, el anillo y el especular)

vertex VOut vsAtomo(uint vid [[vertex_id]],
                    uint iid [[instance_id]],
                    constant Atomo *atomos [[buffer(0)]],
                    constant Marco &m [[buffer(1)]]) {
    Atomo a = atomos[iid];
    // El anillo se traza sobre su radio: el quad lo cubre con medio grosor de holgura.
    float alcance = a.grosor > 0.0 ? a.radio + a.grosor : a.radio;
    float2 q = esquina(vid);
    VOut out;
    out.position = aClip(a.centro + q * alcance, m.lienzo);
    out.uv = q;
    out.color = a.color;
    out.pt = a.centro + q * alcance;
    out.foco = a.foco;
    out.radio = alcance;
    out.radioIni = a.radioIni;
    // El fragmento necesita el grosor y el radio del trazo en unidades del quad.
    out.grosor = a.grosor > 0.0 ? a.grosor / alcance : a.grosor;
    out.suavizado = 1.0;
    return out;
}

// MARK: Fragmento común

fragment float4 fsTrazo(VOut in [[stage_in]]) {
    float d = length(in.uv);
    float aa = max(fwidth(d), 1e-4);
    float cobertura;

    if (in.grosor > 0.0) {
        // Anillo: banda centrada en el radio del trazo (1 − medio grosor en unidades uv).
        float centro = 1.0 - in.grosor;
        float medio = in.grosor * 0.5;
        cobertura = 1.0 - smoothstep(medio - aa, medio + aa, abs(d - centro));
    } else if (in.grosor < 0.0) {
        // Halo: gradiente radial desde `foco` (opaco) hasta el borde del círculo.
        float dd = distance(in.pt, in.foco);
        // Rampa LINEAL, como el `radialGradient` del Canvas — un smoothstep aquí daba
        // una caída distinta y los dos backends dejaban de verse iguales.
        float g = 1.0 - clamp((dd - in.radioIni) / max(in.radio - in.radioIni, 1e-4), 0.0, 1.0);
        cobertura = g * (1.0 - smoothstep(1.0 - aa, 1.0, d));
    } else {
        cobertura = 1.0 - smoothstep(1.0 - aa * in.suavizado, 1.0, d);
    }

    float a = in.color.a * cobertura;
    return float4(in.color.rgb * a, a);   // premultiplicado
}
