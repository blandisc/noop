    "Trends need history to draw. Import your WHOOP export — or connect Apple Health — in Data Sources to see weeks, months and years.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends need history to draw. Import your WHOOP export — or connect Apple Health — in Data Sources to see weeks, months and years."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tendencias necesitan historial para dibujarse. Importa tu exportación de WHOOP — o conecta Apple Health — en Fuentes de datos para ver semanas, meses y años."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends benötigen Verlauf zur Darstellung. Importiere deinen WHOOP-Export — oder verbinde Apple Health — unter Datenquellen, um Wochen, Monate und Jahre zu sehen."
          }
        }
      }
    },
