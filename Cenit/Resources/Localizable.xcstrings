          }
        }
      }
    },
    "A higher VO₂max is associated with a lower risk of all-cause mortality. It's one of the best-evidenced predictors of long-term health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher VO₂max is associated with a lower risk of all-cause mortality. It's one of the best-evidenced predictors of long-term health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VO₂max más alto se asocia con menor riesgo de mortalidad por todas las causas. Es uno de los predictores de salud a largo plazo mejor fundamentados."
          }
        }
      }
    },
    "Mandsager 2018 (JAMA) · Kodama 2009": {
      "extractionState": "manual",
      "localizations": {
