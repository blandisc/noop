          }
        }
      }
    },
    "Your baseline is set. Wear your strap overnight and this morning's recovery, strain and sleep land once it syncs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your baseline is set. Wear your strap overnight and this morning's recovery, strain and sleep land once it syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu línea base ya está lista. Usa la banda durante la noche y la recuperación, el esfuerzo y el sueño de esta mañana aparecen en cuanto sincronice."
          }
        }
      }
    },
    "Your body looks strained — %@. Consider taking it easy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
