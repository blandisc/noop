    },
    "Train by feel — the strap buzzes so you don't have to watch a screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train by feel — the strap buzzes so you don't have to watch a screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena por sensación — la banda zumba para que no tengas que mirar una pantalla."
          }
        }
      }
    },
    "Buzz when you hit your top zone (ease off) and again when you recover. Uses your max HR from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buzz when you hit your top zone (ease off) and again when you recover. Uses your max HR from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zumba cuando llegas a tu zona más alta (baja el ritmo) y otra vez cuando te recuperas. Usa tu FC máx de Ajustes."
          }
        }
      }
    },
    "A gentle buzz when your HRV drops while your heart rate is calm — a cue to take a paced breath. Rate-limited to once every 15 minutes; off by default.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle buzz when your HRV drops while your heart rate is calm — a cue to take a paced breath. Rate-limited to once every 15 minutes; off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zumbido suave cuando tu HRV baja mientras tu pulso está en calma — una señal para respirar con calma. Limitado a una vez cada 15 minutos; apagado por defecto."
          }
        }
      }
    },
    "Wake to a wrist buzz. This arms the strap's own firmware alarm, so it still fires even if your iPhone is asleep or Cénit is closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake to a wrist buzz. This arms the strap's own firmware alarm, so it still fires even if your iPhone is asleep or Cénit is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despierta con un zumbido en la muñeca. Esto arma la alarma del propio firmware de la banda, así que suena aunque tu iPhone esté dormido o Cénit esté cerrado."
          }
        }
      }
    },
    "Arms the strap to buzz at your wake time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms the strap to buzz at your wake time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arma la banda para que zumbe a tu hora de despertar."
          }
        }
      }
    },
    "Watches your resting HR, HRV, skin temperature and respiration against your own 28-day baseline. On-device and approximate — informational only, not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watches your resting HR, HRV, skin temperature and respiration against your own 28-day baseline. On-device and approximate — informational only, not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigila tu FC en reposo, HRV, temperatura de la piel y respiración contra tu propia base de 28 días. En el dispositivo y aproximado — solo informativo, no un diagnóstico."
          }
        }
      }
    },
    "Needs at least 14 days of history. When two or more signals drift together you get a notification — at most once a day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs at least 14 days of history. When two or more signals drift together you get a notification — at most once a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita al menos 14 días de historial. Cuando dos o más señales se desvían juntas, recibes una notificación — máximo una vez al día."
          }
        }
      }
    },
