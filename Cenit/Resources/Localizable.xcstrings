          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy leyendo tus últimos 180 días"
          }
        }
      }
    },
    "onb.4.calibrando.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I already have your %1$#@days@ of history, but I've got %2$#@nights@ with the watch on. Your word arrives as soon as I gather %3$lld."
          },
