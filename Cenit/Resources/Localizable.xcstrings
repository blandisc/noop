    "onb.4.sindatos.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing reached me from Apple Health. Almost always that means the permission stayed off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No me llegó nada de Apple Salud. Casi siempre es que el permiso quedó apagado."
          }
        }
      }
    },
    "onb.4.sindatos.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Health app, find Cénit in your list of apps and turn the signals on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app Salud, busca Cénit en tu lista de apps y enciende las señales."
          }
        }
      }
    },
    "onb.4.sinfc.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't find your resting heart rate. Without it I can't give you the morning reading: it's the signal the whole judgement stands on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encuentro tu frecuencia cardiaca en reposo. Sin ella no puedo darte la lectura de la mañana: es la señal que sostiene todo el juicio."
          }
        }
      }
    },
    "onb.4.sinfc.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a watch, wear it to sleep and your first reading comes within a few nights, as long as the heart permission is on. If it's off, waiting won't help: that's what the Health button below is for. If you have no watch, I'd rather tell you today than leave you waiting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes reloj, duerme con él y tu primera lectura llega en unas cuantas noches, siempre que el permiso del corazón esté encendido. Si está apagado, esperar no sirve: para eso es el botón de Salud de aquí abajo. Si no tienes reloj, prefiero decírtelo hoy que dejarte esperando."
          }
        }
      }
    },
    "onb.4.sinfc.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What does work without a watch is Train: your week's plan, your routines and the progression that climbs on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que sí funciona sin reloj es Entrenar: tu plan de la semana, tus rutinas y la progresión que sube sola."
          }
        }
      }
    },
    "onb.4.sinfc.causa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost always it's one of two things: the heart permission stayed off in Health, or you don't sleep with a watch on yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi siempre es una de dos cosas: el permiso del corazón quedó apagado en Salud, o todavía no duermes con un reloj puesto."
          }
        }
      }
    },
    "onb.4.sinfc.cta" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Train"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir a Entrenar"
          }
        }
      }
    },
    "onb.4.sinfc.cta2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter Cénit anyway"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar a Cénit de todos modos"
          }
        }
      }
    },
    "onb.4.titular.calibrando" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't read you yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no te leo"
          }
        }
      }
    },
    "onb.4.titular.lectura" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I've read it. This is what it says today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya lo leí. Esto es lo que dice hoy."
          }
        }
      }
    },
    "onb.4.titular.sindatos" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing reached me"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No me llegó nada"
          }
        }
      }
    },
    "onb.4.titular.sinfc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't read you"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te puedo leer"
          }
        }
      }
    },
    "onb.5.contra" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heart, against your own nights, never against anybody else's average. Your sleep, against the hours a body asks for, because what you got used to sleeping isn't what you need. That's why I need time before I say anything: by the fourth night I already give you a reading, by the fourteenth I know your normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu corazón, contra tus propias noches, nunca contra el promedio de nadie más. Tu sueño, contra las horas que el cuerpo pide, porque lo que ya te acostumbraste a dormir no es lo que necesitas. Por eso necesito tiempo antes de opinar: a la cuarta noche ya te doy lectura, a la catorce ya conozco tu normal."
          }
        }
      }
    },
    "onb.5.cta" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendido"
          }
        }
      }
    },
    "onb.5.eje.autonomico" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autonomic"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autonómico"
          }
        }
      }
    },
    "onb.5.eje.autonomico.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heart and your nervous system. If this one has no reading, there is no verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu corazón y tu sistema nervioso. Si este no tiene lectura, no hay veredicto."
          }
        }
      }
    },
    "onb.5.eje.sueno" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sueño"
          }
        }
      }
    },
    "onb.5.eje.sueno.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much you slept against the recommended hours. It's the only signal I don't compare against your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto dormiste contra las horas recomendadas. Es la única señal que no comparo contra tu historia."
          }
        }
      }
    },
    "onb.5.eje.temp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperature"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        }
      }
    },
    "onb.5.eje.temp.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far it drifted from your own baseline. On its own it doesn't count: it only adds up the day your breathing steps out with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se separó de tu propia base. Sola no cuenta: suma solo el día que tu respiración se sale con ella."
          }
        }
      }
    },
    "onb.5.glosa.calibrando" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I still have nothing to go on. I'd rather stay quiet than make up a word for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no tengo con qué opinar. Prefiero callarme a inventarte una palabra."
          }
        }
      }
    },
    "onb.5.glosa.caution" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One vote stepped out. Train, but don't chase a record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voto se salió. Entrena, pero sin buscar récord."
          }
        }
      }
    },
    "onb.5.glosa.easy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two or all three stepped out. Your body is paying for something. Bring the load down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos o los tres se salieron. Tu cuerpo está pagando algo. Baja la carga."
          }
        }
      }
    },
    "onb.5.glosa.full" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of the three votes stepped out. Today your body isn't asking you to ease off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de los tres votos se salió. Hoy tu cuerpo no te está pidiendo que bajes."
          }
        }
      }
    },
    "onb.5.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body votes three times every morning, and the word comes out of the count. There is no 0 to 100 score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo vota tres veces cada mañana, y la palabra sale del conteo. No hay puntaje de 0 a 100."
          }
        }
      }
    },
    "onb.5.overline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What it's made of"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De qué está hecho"
          }
        }
      }
    },
    "onb.5.overline.contra" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What I compare you against"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contra qué te comparo"
          }
        }
      }
    },
    "onb.5.overline.dentro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inside the axis that leads"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro del eje que manda"
          }
        }
      }
    },
    "onb.5.overline.ejes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The three votes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tres votos"
          }
        }
      }
    },
    "onb.5.overline.nopesa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What doesn't count, and why"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que no pesa, y por qué"
          }
        }
      }
    },
    "onb.5.overline.palabras" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The four words"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuatro palabras"
          }
        }
      }
    },
    "onb.5.pasos" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your steps, your rings, your streaks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pasos, tus anillos, tus rachas"
          }
        }
      }
    },
    "onb.5.pasos.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They don't come in. What you did yesterday is context for understanding the number, not part of the number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No entran. Lo que hiciste ayer es contexto para entender el número, no parte del número."
          }
        }
      }
    },
    "onb.5.pie" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All of this is always one tap away, in the ⓘ. You can come back whenever you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo esto está siempre a un toque, en la ⓘ. Puedes volver cuando quieras."
          }
        }
      }
    },
    "onb.5.resp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu respiración"
          }
        }
      }
    },
    "onb.5.resp.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On its own it doesn't vote. Together with your temperature, it does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sola no vota. Junto con tu temperatura, sí."
          }
        }
      }
    },
    "onb.5.rhr" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corazón en reposo"
          }
        }
      }
    },
    "onb.5.rhr.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The densest, best validated signal your watch gives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La señal más densa y mejor validada que da tu reloj."
          }
        }
      }
    },
