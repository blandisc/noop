          "stringUnit": {
            "state": "translated",
            "value": "A few extra or skipped beats showed up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vieron algunos latidos extra o salteados."
          }
        }
      }
    },
    "A few more nights of data and your readiness read will sharpen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few more nights of data and your readiness read will sharpen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas cuantas noches más de datos y tu lectura de preparación se afinará."
          }
        }
      }
    },
    "A fixed countdown between sets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed countdown between sets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador fijo entre series."
          }
        }
      }
    },
    "A gentle wrist buzz when you've been sitting a long stretch, so you remember to get up and walk. Sitting less through the day is linked to better long-term health, independent of your workouts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zumbido suave en la muñeca cuando llevas mucho rato sentado, para que te acuerdes de levantarte y caminar. Estar menos tiempo sentado a lo largo del día se asocia con mejor salud a largo plazo, independiente de tu entrenamiento."
          }
        }
      }
    },
    "A glimpse of your rhythm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A glimpse of your rhythm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vistazo a tu ritmo"
          }
        }
      }
    },
    "A hard day of load.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard day of load."
          }
        },
        "es": {
