    "aviso.matutino.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One reminder a day, at the time you pick, on your iPhone. It's a reminder, not the reading: I compute the moment you open me, so your word for the day waits for you inside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo recordatorio al día, a la hora que elijas, en tu iPhone. Es un recordatorio, no la lectura: yo calculo en cuanto me abres, así que tu palabra del día te espera adentro."
