    "Keep wearing your band overnight and this fills in on its own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep wearing your band overnight and this fills in on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue usando tu banda por las noches y esto se completa solo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage deine Band weiter über Nacht, dann füllt sich das von selbst."
          }
        }
      }
    },
    "Lowest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
