    "onb.3.regla" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every morning I compare your heart against your own range, the one that comes out of your nights. Your sleep I measure differently: against the hours any body asks for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mañana comparo tu corazón contra tu propio rango, el que salga de tus noches. Tu sueño lo mido distinto: contra las horas que cualquier cuerpo pide."
          }
        }
      }
    },
    "onb.3.titular" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
