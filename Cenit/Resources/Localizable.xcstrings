    "It's the average oxygen saturation read at your wrist while you sleep, over the last week. A healthy adult usually stays at 95% or above.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the average oxygen saturation read at your wrist while you sleep, over the last week. A healthy adult usually stays at 95% or above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el promedio de la saturación de oxígeno medida en tu muñeca mientras duermes, en la última semana. Un adulto sano suele mantenerse en 95% o más."
          }
        }
      }
    },
