    "Percentage of haemoglobin carrying oxygen in your blood. Healthy adults typically stay above 95%. A drop can indicate altitude effects, sleep apnea, or respiratory illness.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentage of haemoglobin carrying oxygen in your blood. Healthy adults typically stay above 95%. A drop can indicate altitude effects, sleep apnea, or respiratory illness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje de tu hemoglobina que lleva oxígeno. En adultos sanos suele mantenerse por encima del 95%. Una baja puede reflejar el efecto de la altitud, apnea del sueño o una afección respiratoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anteil deines Hämoglobins, der Sauerstoff transportiert. Bei gesunden Erwachsenen liegt er meist über 95%. Ein Abfall kann auf Höhe, Schlafapnoe oder eine Atemwegserkrankung hindeuten."
          }
        }
      }
    },
    "Physical age": {
      "extractionState": "manual",
