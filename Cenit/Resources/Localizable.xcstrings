    "prep.permiso.cuerpo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I build Preparation from what your watch already saves in Apple Health: resting heart rate, HRV, sleep, temperature and breathing. Without that permission I have nothing to read. Everything stays on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armo Preparación con lo que tu reloj ya guarda en Apple Salud: FC en reposo, VFC, sueño, temperatura y respiración. Sin ese permiso no tengo nada que leer. Todo se queda en tu iPhone."
          }
        }
