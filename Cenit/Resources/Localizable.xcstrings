    "Daily step count. Consistent activity — even a 30-minute walk — supports cardiovascular health, mood, and recovery quality.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily step count. Consistent activity — even a 30-minute walk — supports cardiovascular health, mood, and recovery quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conteo de pasos del día. La actividad constante —aunque sea una caminata de 30 minutos— apoya tu salud cardiovascular, tu ánimo y la calidad de tu recuperación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schrittzahl des Tages. Beständige Aktivität — schon ein 30-minütiger Spaziergang — unterstützt Herz-Kreislauf-Gesundheit, Stimmung und Erholungsqualität."
          }
        }
      }
    },
