          }
        }
      }
    },
    "How steady your sleep schedule is: we take each night's midpoint (between falling asleep and waking) and measure how much it shifts night to night. Less drift, closer to 100." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
