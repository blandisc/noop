            "value" : "vota"
          }
        }
      }
    },
    "onb.5.vfcdia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All-day variability"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variabilidad de todo el día"
          }
        }
      }
    },
    "onb.5.vfcdia.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It left the vote: it's a whole-day measure and it came out worse than your heart's. I still show it, but it doesn't vote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salió del voto: es una medida de día entero y resultó peor que la del corazón. La sigo mostrando, pero no vota."
          }
        }
      }
    },
    "onb.5.vfcnoche" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night variability"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabilidad de la noche"
          }
        }
      }
    },
    "onb.5.vfcnoche.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only counts if the night came with enough detail. It never votes alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuenta si la noche vino con suficiente detalle. Nunca vota sola."
          }
        }
      }
    },
    "onb.6.caution" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same load as last time. Today is not for chasing a record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misma carga que la última vez. Hoy no se busca récord."
          }
        }
      }
    },
    "onb.6.cierre.aviso" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want, I'll set you a reminder at whatever time you pick. It lives in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres, te pongo un recordatorio a la hora que elijas. Vive en Ajustes."
          }
        }
      }
    },
    "onb.6.cierre.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the watch on. In the morning you open me and your word is already there: you don't have to log anything or ask me for anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el reloj puesto. En la mañana me abres y tu palabra ya está ahí: no tienes que registrar nada ni pedirme nada."
          }
        }
      }
    },
    "onb.6.cierre.cuerpo.sinreloj" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your watch is already giving me your days. Sleep with it on and I start reading your nights. That's where your morning word comes from."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reloj ya me da tus días. Duerme con él puesto y empiezo a leer tus noches: de ahí sale tu palabra de la mañana."
          }
        }
      }
    },
    "onb.6.cierre.titular" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
