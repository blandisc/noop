    "acta.metodo.fc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your resting HR is your lowest pulse of the night, measured by your Apple Watch; when there's no overnight reading, Cénit uses Apple Health's resting heart rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu FC en reposo es tu pulso más bajo de la noche, medido con el Apple Watch; cuando no hay lectura nocturna, Cénit usa la FC en reposo de Apple."
          }
        }
      }
    },
    "acta.metodo.histeresis" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new verdict has to repeat two days in a row before it replaces the previous one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un veredicto nuevo tiene que repetirse dos días seguidos antes de reemplazar al anterior."
          }
        }
      }
    },
    "acta.metodo.que" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The verdict for how you woke up: your resting HR against your own baseline; your sleep, against the recommended range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El veredicto de cómo amaneciste: tu FC en reposo contra tu propia base; tu sueño, contra el rango recomendado."
          }
        }
      }
    },
    "acta.metodo.votos" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sleep and your resting HR are read as separate votes, so a bad night doesn't count twice. Your breathing and temperature only watch: a single one never counts, and they add one vote only on the day both step out together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueño y tu FC en reposo se leen como votos separados, para que una mala noche no cuente dos veces. Tu respiración y tu temperatura solo vigilan: una sola nunca cuenta, y suman un voto únicamente el día que las dos se salen juntas."
          }
        }
      }
    },
