            "state": "translated",
            "value": "Aún no hay suficientes datos, sigue usando tu banda y vuelve en unas semanas."
          }
        }
      }
    },
    "Nothing proven yet — your experiments will land here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada confirmado aún, tus experimentos caerán aquí."
          }
        }
