        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión exigente. Prioriza dormir hoy."
          }
        }
      }
    },
    "A few extra or skipped beats showed up.": {
      "extractionState": "manual",
      "localizations": {
