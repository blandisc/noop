      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te dice qué día empieza tu siguiente periodo."
          }
        }
      }
    },
    "It held up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sostuvo."
          }
        }
      }
    },
    "It is not a contraceptive method.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un método anticonceptivo."
          }
        }
      }
    },
    "It looks like there's no data on this device. If you've used Cénit before — on this phone or another — restore your strap history and settings from an iCloud Drive backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like there's no data on this device. If you've used Cénit before — on this phone or another — restore your strap history and settings from an iCloud Drive backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no hay datos en este dispositivo. Si ya usaste Cénit antes, en este teléfono u otro, restaura el historial de tu banda y tus ajustes desde un respaldo en iCloud Drive."
          }
        }
      }
    },
    "It looks like there's no data on this device. If you've used NOOP before — on this phone or another — restore your strap history and settings from an iCloud Drive backup.": {
