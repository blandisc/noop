    "onb.perfil.buscando" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking for what Apple Health already knows about you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando lo que Apple Salud ya sabe de ti."
          }
        }
      }
    },
    "onb.perfil.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your morning word already came out of your heart and your sleep. This is for the other half: your age gives me your heart rate zones, and your sex, your weight and your height fine-tune what you burn when you train."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu palabra de la mañana ya salió de tu corazón y de tu sueño. Esto es para la otra mitad: tu edad me da tus zonas de frecuencia cardiaca, y tu sexo, tu peso y tu estatura afinan lo que gastas al entrenar."
          }
        }
      }
    },
    "onb.perfil.cuerpo.sinlectura" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This doesn't come out of your signals, you have to tell me: your age gives me your heart rate zones, and your sex, your weight and your height fine-tune what you burn when you train."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no sale de tus señales, me lo tienes que decir tú: tu edad me da tus zonas de frecuencia cardiaca, y tu sexo, tu peso y tu estatura afinan lo que gastas al entrenar."
          }
        }
      }
    },
    "onb.perfil.fcmax" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your estimated max heart rate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu FC máxima estimada"
          }
        }
      }
    },
    "onb.perfil.fcmax.nota" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It comes out of your age. If you know your real one from a test, you can set it by hand in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale de tu edad. Si conoces la tuya de una prueba, puedes ponerla a mano en Ajustes."
          }
        }
      }
    },
