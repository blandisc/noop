    "Combined resting-HR / HRV z-score through a logistic curve. HRV via RMSSD (Task Force, 1996). An estimate, not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combined resting-HR / HRV z-score through a logistic curve. HRV via RMSSD (Task Force, 1996). An estimate, not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Z-score combinado de frecuencia en reposo / HRV a través de una curva logística. HRV vía RMSSD (Task Force, 1996). Una estimación, no un diagnóstico."
          }
        }
      }
    },
    "Combined resting-HR / HRV z-score through a logistic curve; HRV via RMSSD (Task Force, 1996).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combined resting-HR / HRV z-score through a logistic curve; HRV via RMSSD (Task Force, 1996)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Z-score combinado de FC en reposo y HRV a través de una curva logística; HRV vía RMSSD (Task Force, 1996)."
          }
        }
      }
