        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días que registraste ‘%1$@’, %2$@ fue %3$@ (prom. %4$lld vs %5$lld, n=%6$lld vs %7$lld)."
          }
        }
      }
    },
