    "Live heart rate": {
      "comment": "An accessibility label for the live heart-rate pill when it is live.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecuencia cardiaca en vivo"
          }
        }
      }
    },
    "Live heart rate already works on a WHOOP 5/MG strap. These probes go further and try to coax more out of it. They are guesses, off by default, and only ever touch a 5/MG strap — WHOOP 4.0 is never affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live heart rate already works on a WHOOP 5/MG strap. These probes go further and try to coax more out of it. They are guesses, off by default, and only ever touch a 5/MG strap — WHOOP 4.0 is never affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia cardiaca en vivo ya funciona en una banda WHOOP 5/MG. Estas sondas van más allá e intentan sacarle más. Son conjeturas, vienen apagadas por defecto y solo tocan una banda 5/MG — WHOOP 4.0 nunca se ve afectada."
          }
        }
      }
    },
    "Live heart rate only — finish secure pairing to save the rest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live heart rate only — finish secure pairing to save the rest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo frecuencia en vivo — completa el emparejamiento seguro para guardar lo demás"
          }
        }
      }
    },
