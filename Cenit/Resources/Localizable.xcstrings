    "Based on the Nes/HUNT model (2011): it estimates your aerobic capacity from your resting heart rate and activity, and compares it with the average for your age.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the Nes/HUNT model (2011): it estimates your aerobic capacity from your resting heart rate and activity, and compares it with the average for your age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en el modelo Nes/HUNT (2011): estima tu capacidad aeróbica a partir de tu FC en reposo y tu actividad, y la compara con el promedio de tu edad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf dem Nes/HUNT-Modell (2011): Es schätzt deine aerobe Kapazität aus deiner Ruheherzfrequenz und Aktivität und vergleicht sie mit dem Durchschnitt für dein Alter."
          }
        }
      }
    },
    "We can't calculate your physical age yet.": {
      "extractionState": "manual",
      "localizations": {
