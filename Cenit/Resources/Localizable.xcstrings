    "You woke up well recovered. What needs care today is your training load, not your body.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You woke up well recovered. What needs care today is your training load, not your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaneciste muy recuperado. Lo que pide cuidado: hoy es tu carga, no tu cuerpo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist gut erholt aufgewacht. Worauf du heute achten musst, ist deine Belastung, nicht dein Körper."
          }
        }
      }
    },
    "You're connected.": {
      "localizations": {
        "de": {
