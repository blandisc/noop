    },
    "manual.contexto.carga.sub" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much training you've been piling up lately, against what's usual for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto entrenamiento vienes acumulando últimamente, comparado con lo que es normal en ti."
          }
        }
      }
    },
    "manual.contexto.esfuerzo" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esfuerzo"
          }
        }
      }
    },
    "manual.contexto.esfuerzo.sub" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you've built up so far today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que llevas construido en el día."
          }
        }
      }
    },
    "manual.contexto.estres" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrés"
          }
        }
      }
    },
    "manual.contexto.estres.sub" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your estimated stress level for the day, on a low-to-high scale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nivel de estrés estimado del día, en una escala de bajo a alto."
          }
        }
      }
    },
    "manual.contexto.intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These don't decide your day: only your sleep and resting heart rate vote. They're here to give you context around that verdict, never to judge it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas señales no deciden tu día: solo tu sueño y tu FC en reposo votan. Están aquí para darte contexto alrededor de ese veredicto, nunca para juzgarlo."
          }
        }
      }
    },
    "manual.contexto.pasos" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos"
          }
        }
      }
    },
    "manual.contexto.pasos.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much you've moved today, next to your last two weeks. A count, not a judgment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto te has movido hoy, junto a tus últimas dos semanas. Un conteo, no un juicio."
          }
        }
      }
    },
    "manual.contexto.porque" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a wrist watch, HRV and stress aren't stable enough to decide with. Your watch's daytime HRV drifts about 29% from a chest-strap reference, so we show it as a quiet line where you usually sit, never as a range you crossed. Your resting heart rate and sleep carry the verdict; these ride along as context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un reloj de muñeca, la VFC y el estrés no son lo bastante estables para decidir con ellos. La VFC de día de tu reloj se aleja alrededor de 29% de una referencia de banda de pecho, así que la mostramos como una línea quieta donde sueles estar, nunca como un rango que cruzaste. Tu FC en reposo y tu sueño llevan el veredicto; estas van de acompañantes."
          }
        }
      }
    },
    "manual.contexto.sec.porque" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why they don't vote"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por qué no votan"
          }
        }
      }
    },
    "manual.contexto.sec.que" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What each one is"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué es cada una"
          }
        }
      }
    },
    "manual.contexto.titulo" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your context"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contexto"
          }
        }
      }
    },
    "manual.contexto.vfc" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VFC"
          }
        }
      }
    },
    "manual.contexto.vfc.sub" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heart-rate variability, estimated by your watch through the day. The dotted line is where you usually sit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu variabilidad de la frecuencia cardiaca, estimada por tu reloj a lo largo del día. La línea punteada es donde sueles estar."
          }
        }
      }
    },
    "manual.deciden.c1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All in your range"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en tu rango"
          }
        }
      }
    },
    "manual.deciden.c1.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No signal out. Your body woke up where it usually does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna señal fuera. Tu cuerpo amaneció donde suele."
          }
        }
      }
    },
    "manual.deciden.c2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good, with one detail"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien, con un detalle"
          }
        }
      }
    },
    "manual.deciden.c2.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One signal out of your range, and I tell you which."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una señal fuera de tu rango: te digo cuál."
          }
        }
      }
    },
    "manual.deciden.c3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take it easy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ándate leve"
          }
        }
      }
    },
    "manual.deciden.c3.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two or more votes out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos votos o más fuera."
          }
        }
      }
    },
    "manual.deciden.c4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low signal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja señal"
          }
        }
      }
    },
    "manual.deciden.c4.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough reading tonight. Without data I don't guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hubo lectura suficiente esta noche. Sin datos no adivino."
          }
        }
      }
    },
    "manual.deciden.como" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From your recent weeks I learn your normal band for your resting heart rate and your breathing; your temperature is measured by how far it drifts from your own baseline, against a fixed cut that is the same for everyone, and your sleep against the recommended range for health. Each morning I compare the night: in or out. The verdict counts how many voting signals stepped out. It is never a 0-100 score, because your watch doesn't measure with that precision and I won't pretend it does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tus últimas semanas aprendo tu banda normal de FC en reposo y de respiración; tu temperatura se mide por cuánto se aleja de tu propia base, contra un corte fijo que es igual para todos, y tu sueño, contra el rango recomendado para la salud. Cada mañana comparo la noche: dentro o fuera. El veredicto cuenta cuántas señales votantes se salieron. Nunca es una calificación de 0 a 100, porque tu reloj no mide con esa precisión y no voy a fingir que sí."
          }
        }
      }
    },
    "manual.deciden.fc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting heart rate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC en reposo"
          }
        }
      }
    },
    "manual.deciden.fc.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lowest pulse of the night, against your recent weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pulso más bajo de la noche, contra tus últimas semanas."
          }
        }
      }
    },
    "manual.deciden.guardian" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guardian"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El guardián"
          }
        }
      }
    },
    "manual.deciden.guardian.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperature and breathing watch together. They only weigh in when both step out at once; one alone can be noise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura y respiración vigilan juntas. Solo pesan si las dos se salen a la vez: una sola puede ser ruido."
          }
        }
      }
    },
    "manual.deciden.hedge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wrist-watch reading: an honest approximation, not a diagnosis. Cénit is not a medical device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lectura de un reloj de muñeca: una aproximación honesta, no un diagnóstico. Cénit no es un dispositivo médico."
          }
        }
      }
    },
    "manual.deciden.promesa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every morning I read your night and tell you one thing: whether you woke up inside your range. Your resting heart rate is compared against your own recent weeks; your sleep, against the recommended range for health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mañana leo tu noche y te digo una cosa: si amaneciste dentro de tu rango. Tu FC en reposo se compara contra tus propias semanas recientes; tu sueño, contra el rango recomendado para la salud."
          }
        }
      }
    },
