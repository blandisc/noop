    "onb.2.titular" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read it, I need you to open the door"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leerlo necesito que me abras la puerta"
          }
        }
      }
    },
    "onb.2.vfcdia.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It left the vote: it's a whole-day measure and it came out worse than your heart's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salió del voto: es medida de día entero y resultó peor que la del corazón."
          }
        }
      }
    },
    "onb.2.vfcdia.nombre" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
