    },
    "You're on the latest (%@).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión más reciente (%@)."
          }
        }
      }
    },
    "You're sitting around your typical autonomic baseline — moderate stress, a normal, balanced day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sitting around your typical autonomic baseline — moderate stress, a normal, balanced day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás alrededor de tu línea base autonómica típica — estrés moderado, un día normal y equilibrado."
          }
        }
      }
    },
    "Your autonomic load today, from 0 to 3. We estimate it by comparing today's resting heart rate and HRV with your own 30-day baseline: a higher-than-usual resting HR and a lower-than-usual HRV both push the number up — classic signs your body is activated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your autonomic load today, from 0 to 3. We estimate it by comparing today's resting heart rate and HRV with your own 30-day baseline: a higher-than-usual resting HR and a lower-than-usual HRV both push the number up — classic signs your body is activated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carga autonómica de hoy, del 0 al 3. La estimamos comparando tu frecuencia cardíaca en reposo y tu HRV con tu propia línea base de 30 días: una FC en reposo más alta de lo normal y una HRV más baja empujan el número hacia arriba — señales clásicas de que tu cuerpo está activado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine autonome Belastung heute, von 0 bis 3. Wir schätzen sie, indem wir deinen heutigen Ruhepuls und deine HRV mit deiner eigenen 30-Tage-Basislinie vergleichen: ein höherer Ruhepuls als üblich und eine niedrigere HRV treiben den Wert nach oben — klassische Zeichen dafür, dass dein Körper aktiviert ist."
          }
        }
      }
    },
    "Your autonomic markers are skewed toward stress today. Treat it as a recovery-focused day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your autonomic markers are skewed toward stress today. Treat it as a recovery-focused day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus marcadores autonómicos se inclinan hacia el estrés hoy. Tómalo como un día enfocado en recuperarte."
          }
        }
      }
    },
    "Your baseline comes from Apple Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Basislinie stammt aus Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your baseline comes from Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu base viene de Apple Health."
          }
        }
      }
    },
    "Your baseline is ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your baseline is ready"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu base ya está lista"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Basislinie ist bereit"
          }
        }
      }
    },
    "Your baseline is set. Wear your strap overnight and this morning's recovery, strain and sleep land once it syncs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your baseline is set. Wear your strap overnight and this morning's recovery, strain and sleep land once it syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu línea base ya está lista. Usa la banda durante la noche y la recuperación, el esfuerzo y el sueño de esta mañana aparecen en cuanto sincronice."
          }
        }
      }
    },
    "Your body looks strained — %@. Consider taking it easy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body looks strained — %@. Consider taking it easy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo se ve exigido — %@. Considera tomártelo con calma."
          }
        }
      }
    },
    "Your data has been restored. Reopen Cénit for it to take effect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data has been restored. Reopen Cénit for it to take effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se restauraron. Vuelve a abrir Cénit para que surta efecto."
          }
        }
      }
    },
    "Your data has been restored. Reopen NOOP for it to take effect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
