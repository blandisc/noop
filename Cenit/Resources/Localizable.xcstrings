    "onb.1.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I read it every morning and tell you, in one word, how you woke up. And when you train, I carry your routine and add weight the day it's due."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo lo leo cada mañana y te digo, en una palabra, cómo amaneciste. Y cuando entrenas, te llevo la rutina y te subo el peso el día que te toca."
          }
        }
      }
    },
    "onb.1.privacidad" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no email, no cloud. Everything is computed on your iPhone. Put it in airplane mode and check right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin correo, sin nube. Todo se calcula en tu iPhone. Ponlo en modo avión y compruébalo ahora mismo."
          }
        }
      }
    },
    "onb.1.titular" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body has been keeping the record. Nobody has read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo ya lleva el registro. Nadie lo ha leído."
          }
        }
      }
    },
    "onb.2.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I don't go out looking for anything. Apple has to hand me your signals, and only you can authorize that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo no salgo a buscar nada. Apple me tiene que pasar tus señales, y eso lo autorizas tú."
          }
        }
      }
    },
    "onb.2.grupo.fuera" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The one that no longer comes in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La que ya no entra"
          }
        }
      }
    },
    "onb.2.grupo.par" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two that only count together"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dos que solo cuentan juntas"
          }
        }
      }
    },
    "onb.2.grupo.sostiene" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The one that holds it all up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La que sostiene todo"
          }
        }
      }
    },
    "onb.2.grupo.votan" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other vote"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro voto"
          }
        }
      }
    },
    "onb.2.nota.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple opens this permission switched off. If you give me only part of it, I go mute and I can't tell you which piece is missing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple abre este permiso apagado. Si me das solo una parte, me quedo mudo y no puedo decirte cuál falta."
          }
        }
      }
    },
    "onb.2.nota.fuerte" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for “Turn On All” and switch it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca «Activar todo» y préndelo."
          }
        }
      }
    },
    "onb.2.par.pie" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day both step out together, they add one vote. Either one on its own stays a heads-up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El día que las dos se salgan juntas, suman un voto. Cualquiera por su cuenta se queda en aviso."
          }
        }
      }
    },
    "onb.2.resp.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It speeds up when something is coming on. On its own it doesn't count either."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se acelera cuando algo se está gestando. Sola tampoco cuenta."
          }
        }
      }
    },
    "onb.2.resp.nombre" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiración"
          }
        }
      }
    },
    "onb.2.rhr.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backbone. Without it there is no reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La espina dorsal. Sin ella no hay lectura."
          }
        }
      }
    },
    "onb.2.rhr.nombre" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
