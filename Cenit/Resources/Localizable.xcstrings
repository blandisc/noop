    },
    "You're on the latest (%@).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión más reciente (%@)."
          }
        }
      }
    },
    "You're sitting around your typical autonomic baseline — moderate stress, a normal, balanced day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sitting around your typical autonomic baseline — moderate stress, a normal, balanced day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás alrededor de tu línea base autonómica típica — estrés moderado, un día normal y equilibrado."
          }
        }
      }
    },
    "Your average": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu promedio"
          }
        }
      }
    },
    "Your autonomic load for the day: how activated your body is. We take today's resting heart rate and HRV, compare each with your own 30-day baseline as a z-score, and map the combined shift onto a 0–3 scale through a logistic curve (0 calm · 1.5 your baseline · 3 highly activated). It's an estimate, not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your autonomic load for the day: how activated your body is. We take today's resting heart rate and HRV, compare each with your own 30-day baseline as a z-score, and map the combined shift onto a 0–3 scale through a logistic curve (0 calm · 1.5 your baseline · 3 highly activated). It's an estimate, not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carga autonómica del día: qué tan activado está tu cuerpo. Tomamos tu frecuencia en reposo y tu HRV de hoy, comparamos cada una con tu propia base de 30 días como z-score, y mapeamos el desplazamiento combinado a una escala 0–3 con una curva logística (0 en calma · 1.5 tu base · 3 muy activado). Es una estimación, no un diagnóstico."
          }
        }
      }
    },
    "Your autonomic load today, from 0 to 3. We estimate it by comparing today's resting heart rate and HRV with your own 30-day baseline: a higher-than-usual resting HR and a lower-than-usual HRV both push the number up — classic signs your body is activated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your autonomic load today, from 0 to 3. We estimate it by comparing today's resting heart rate and HRV with your own 30-day baseline: a higher-than-usual resting HR and a lower-than-usual HRV both push the number up — classic signs your body is activated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carga autonómica de hoy, del 0 al 3. La estimamos comparando tu frecuencia cardíaca en reposo y tu HRV con tu propia línea base de 30 días: una FC en reposo más alta de lo normal y una HRV más baja empujan el número hacia arriba — señales clásicas de que tu cuerpo está activado."
          }
        }
      }
    },
    "Your autonomic markers are skewed toward stress today. Treat it as a recovery-focused day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your autonomic markers are skewed toward stress today. Treat it as a recovery-focused day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus marcadores autonómicos se inclinan hacia el estrés hoy. Tómalo como un día enfocado en recuperarte."
          }
        }
      }
    },
    "Your baseline comes from Apple Health.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your baseline comes from Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu base viene de Apple Health."
          }
        }
      }
    },
    "Your baseline is ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
