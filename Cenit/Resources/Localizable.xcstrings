    "Derived from your overnight resting heart rate and HRV — a transparent proxy for autonomic load, not a clinical stress measure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Derived from your overnight resting heart rate and HRV — a transparent proxy for autonomic load, not a clinical stress measure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deriva de tu frecuencia cardíaca en reposo y tu HRV nocturnas — un proxy transparente de la carga autonómica, no una medida clínica de estrés."
          }
        },
        "de": {
