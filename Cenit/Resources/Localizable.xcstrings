        }
      }
    },
    "I haven't found a habit with a clear effect on your numbers yet. Keep logging your day and I'll spot it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I haven't found a habit with a clear effect on your numbers yet. Keep logging your day and I'll spot it."
          }
        },
        "es": {
