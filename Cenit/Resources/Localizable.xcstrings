    "onb.2.vfcnoche.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weighs half, and only when the night came with enough detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
