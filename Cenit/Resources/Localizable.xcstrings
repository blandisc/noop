    "onb.salida.cuerpo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I won't push you. But so you know where you stand: without permission I can't see your heart or your sleep, and the morning verdict is exactly that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te voy a insistir. Pero para que sepas dónde quedas: sin permiso no puedo ver tu corazón ni tu sueño, y el veredicto de la mañana es justamente eso."
          }
        }
      }
    },
    "onb.salida.no" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The morning verdict, no"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El veredicto de la mañana, no"
          }
        }
      }
    },
    "onb.salida.overline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's okay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está bien"
          }
        }
      }
    },
    "onb.salida.pie" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
