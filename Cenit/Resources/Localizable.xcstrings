    "Live HR works — free the strap to unlock buzz, alarms & sync": {
      "comment": "A hint to pair the Live HR strap.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La FC en vivo funciona — libera la banda para desbloquear vibración, alarmas y sincronización"
