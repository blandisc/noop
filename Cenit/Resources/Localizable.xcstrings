    "Wrist delivery isn't live yet — it needs a small on-device watcher (coming in an update) to read macOS notifications. Everything stays on this Mac. Your choices are saved now and will apply automatically once delivery ships.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist delivery isn't live yet — it needs a small on-device watcher (coming in an update) to read macOS notifications. Everything stays on this Mac. Your choices are saved now and will apply automatically once delivery ships."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrega en la muñeca aún no está activa — necesita un pequeño observador en el dispositivo (llegará en una actualización) para leer las notificaciones de macOS. Todo se queda en esta Mac. Tus elecciones quedan guardadas y se aplicarán automáticamente cuando la entrega esté lista."
          }
        }
      }
    },
    "Blood oxygen comes from Apple Health. Wrist-based sensors have lower accuracy than medical pulse oximeters — treat values as a trend, not a clinical reading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood oxygen comes from Apple Health. Wrist-based sensors have lower accuracy than medical pulse oximeters — treat values as a trend, not a clinical reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El oxígeno en sangre viene de Apple Salud. Los sensores de muñeca son menos precisos que un oxímetro médico: tómalo como tendencia, no como una lectura clínica."
          }
        }
      }
    },
