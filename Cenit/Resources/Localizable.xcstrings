            "value": "Where your recovery usually lands when you're well. Worth noting when a day falls outside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde suele caer tu recuperación cuando estás bien. Vale la pena fijarse cuando un día se sale de ahí."
          }
        }
      }
    },
