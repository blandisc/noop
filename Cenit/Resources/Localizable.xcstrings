          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un atajo cuando te quitas o te pones la banda — activa un modo de Concentración, pausa el audio, márcate ausente."
          }
        }
      }
    },
    "Presence automation — set a Focus, pause media, set away…": {
      "extractionState": "manual",
