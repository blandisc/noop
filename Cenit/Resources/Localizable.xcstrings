    "Your recovery is high, but %@ is flagging — keep an eye on that today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery is high, but %@ is flagging — keep an eye on that today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recuperación va alta, pero %@ trae una señal abajo — ojo con eso hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Erholung ist hoch, aber %@ schlägt an — behalte das heute im Auge."
          }
        }
      }
    },
    "Your recovery sums up how ready your body is today, from 0 to 100. It blends several signals from your night — your HRV above all — and compares them with your own average from recent weeks, not anyone else's.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery sums up how ready your body is today, from 0 to 100. It blends several signals from your night — your HRV above all — and compares them with your own average from recent weeks, not anyone else's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recuperación resume qué tan listo está tu cuerpo hoy, del 0 al 100. Combina varias señales de tu noche —sobre todo tu HRV— y las compara con tu propio promedio de las últimas semanas, no con el de nadie más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Erholung fasst zusammen, wie bereit dein Körper heute ist, von 0 bis 100. Sie verbindet mehrere Signale deiner Nacht — vor allem deine HRV — und vergleicht sie mit deinem eigenen Durchschnitt der letzten Wochen, nicht mit dem anderer."
          }
        }
      }
    },
