    "terms.point1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cénit reads your health and fitness data directly from Apple Health, on your iPhone — no separate hardware pairing required."
          }
