    "onb.2.temp.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rises when something is brewing. On its own it doesn't count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube cuando algo se está incubando. Sola no cuenta."
          }
        }
