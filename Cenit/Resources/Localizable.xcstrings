          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué tan parejo es tu horario de sueño: tomamos el centro de cada noche (entre dormirte y despertar) y medimos cuánto brinca de noche a noche. Menos brincos, más cerca de 100."
          }
