    "prep.vacio.imposible" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of these 30 mornings had enough signal. Preparation needs your resting signals while you sleep, and they haven't come in: if you don't wear your watch at night, I won't be able to read them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de estas 30 mañanas tuvo señal suficiente. Preparación necesita tus señales en reposo mientras duermes, y no han llegado: si no traes el reloj de noche, no voy a poder leerlas."
          }
        }
      }
