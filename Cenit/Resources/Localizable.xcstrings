    "A WHOOP 4.0 sends no step count, so Cénit estimates steps from wrist motion calibrated against your iPhone. It is always an estimate, never an exact count.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La WHOOP 4.0 no manda conteo de pasos, así que Cénit los estima desde el movimiento de la muñeca, calibrado contra tu iPhone. Siempre es una estimación, nunca un conteo exacto."
          }
        }
      }
    },
    "A WHOOP export backfills recovery, strain, sleep and workouts. An Apple Health export adds HR, HRV, sleep, blood oxygen, steps and weight.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A WHOOP export backfills recovery, strain, sleep and workouts. An Apple Health export adds HR, HRV, sleep, blood oxygen, steps and weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una exportación de WHOOP rellena recuperación, esfuerzo, sueño y entrenamientos. Una exportación de Apple Salud agrega FC, HRV, sueño, oxígeno, pasos y peso."
          }
        }
      }
    },
    "A change counts only when it leaves the band.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A change counts only when it leaves the band."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio cuenta solo si sale de la banda."
          }
        }
      }
    },
    "A composite of z-scores through a logistic curve. HRV via RMSSD (Task Force, 1996).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A composite of z-scores through a logistic curve. HRV via RMSSD (Task Force, 1996)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compuesto de z-scores con una curva logística. HRV vía RMSSD (Task Force, 1996)."
          }
        }
      }
    },
    "A composite of z-scores through a logistic curve. HRV via RMSSD (Task Force, 1996; Plews 2013; Buchheit 2014; Impellizzeri 2020).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A composite of z-scores through a logistic curve. HRV via RMSSD (Task Force, 1996; Plews 2013; Buchheit 2014; Impellizzeri 2020)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compuesto de z-scores a través de una curva logística. VFC vía RMSSD (Task Force, 1996; Plews 2013; Buchheit 2014; Impellizzeri 2020)."
          }
        }
      }
    },
    "A demanding session. Make sleep a priority today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A demanding session. Make sleep a priority today."
