        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde Apple Salud"
          }
        }
      }
    },
    "onb.perfil.marca.tuyo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set this one"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo pusiste tú"
          }
        }
      }
    },
    "onb.perfil.nota.salud" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Apple Health already knew is filled in, and it stays editable. Fix anything that looks off: what you set wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que Apple Salud ya sabía quedó puesto, y sigue siendo editable. Corrige lo que no cuadre: lo que tú pongas manda."
          }
        }
      }
    },
    "onb.perfil.nota.sinpermiso" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't connect Apple Health, so I set these four myself to get started. Adjust them, or your zones will be an average person's instead of yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conectaste Apple Salud, así que estos cuatro los puse yo para arrancar. Ajústalos, o tus zonas serán las de una persona promedio en vez de las tuyas."
          }
        }
      }
    },
    "onb.perfil.nota.sinsalud" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health gave me none of these, so I filled them in myself to get started. Adjust them, or your zones will be an average person's instead of yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salud no me dio ninguno de estos datos, así que los puse yo para arrancar. Ajústalos, o tus zonas serán las de una persona promedio en vez de las tuyas."
          }
        }
      }
    },
    "onb.perfil.overline" : {
      "extractionState" : "manual",
