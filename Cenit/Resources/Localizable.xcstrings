          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recuperación resume qué tan listo está tu cuerpo hoy, del 0 al 100. Combina varias señales de tu noche, sobre todo tu VFC, y las compara con tu propio promedio de las últimas semanas, no con el de nadie más."
          }
        }
