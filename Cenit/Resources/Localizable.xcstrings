    "onb.2.sueno.glosa" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much you slept against the hours a body asks for, and how even it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto dormiste contra las horas que el cuerpo pide, y qué tan parejo."
