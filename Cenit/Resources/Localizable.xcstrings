        }
      }
    },
    "The more you log, the more patterns I find" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto más anotas, más patrones encuentro"
          }
        }
      }
    },
    "The most oxygen your body can use during hard exercise, per kilo of body weight. It's the single best measure of cardiorespiratory fitness, and one of the best-evidenced predictors of long-term health." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most oxygen your body can use during hard exercise, per kilo of body weight. It's the single best measure of cardiorespiratory fitness, and one of the best-evidenced predictors of long-term health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El máximo de oxígeno que tu cuerpo puede usar en ejercicio intenso, por kilo de peso. Es la mejor medida de tu condición cardiorrespiratoria, y uno de los predictores de salud a largo plazo mejor fundamentados."
          }
        }
      }
    },
    "The oxygen in your blood, read at your wrist while you sleep. A healthy adult usually stays at 95% or above." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oxygen in your blood, read at your wrist while you sleep. A healthy adult usually stays at 95% or above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El oxígeno en tu sangre, medido en la muñeca mientras duermes. Un adulto sano suele mantenerse en 95% o más."
          }
        }
      }
    },
    "The phase is estimated from the temperature your band measures while you sleep. When you sync nights with the band again, I'll pick the reading back up." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fase se estima con la temperatura que tu banda mide mientras duermes. Cuando vuelvas a sincronizar noches con la banda, retomo la lectura."
          }
        }
      }
    },
    "The plan" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan"
          }
        },
